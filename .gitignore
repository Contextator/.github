# Single source of truth lives in the separate <repo>.ssot repository
/.ssot/

# Environment files: never commit; document variables in .env.example
.env
.env.*
!.env.example

# OS files
.DS_Store

# Editors and IDEs (shared VS Code settings stay versioned)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
